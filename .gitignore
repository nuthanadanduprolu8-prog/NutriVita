# ==============================================================================
# NutriVita Root .gitignore
# Prevents secrets, environment files, dependencies, and build artifacts from Git
# ==============================================================================

# 1. Environment Variables & Secret Keys (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
*.env.*
!*.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# 2. Node Dependencies
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/

# 3. Production Build Artifacts & Caches
dist/
dist-ssr/
client/dist/
client/dist-ssr/
build/
.cache/
.parcel-cache/
.vite/

# 4. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Temporary & Scratch Files
tmp/
temp/
scratch/
